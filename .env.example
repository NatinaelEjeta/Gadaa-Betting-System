# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string (for example from Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Random secret for login sessions (generate your own)
JWT_SECRET=

# Chapa: false = real Chapa API (use a CHASECK_TEST key), true = built-in simulator
CHAPA_TEST_MODE=true
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# Sports data: mock = built-in simulator, api-football = real data (paid plan needed for current seasons)
SPORTS_PROVIDER=mock
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE_IDS=39,140,2

# SMS codes: console prints them in the server window (development only)
SMS_PROVIDER=console
NEXT_PUBLIC_WITHDRAW_SMS=true

# Local runs only: start the background worker
ENABLE_WORKER=true
